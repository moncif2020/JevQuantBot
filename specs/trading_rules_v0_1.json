{
  "specification_version": "0.1.0",
  "name": "JevQuant Institutional Spot Strategy V0.1",
  "description": "قواعد ثابتة لإستراتيجية التداول الفوري الكمي مع معايرة الثقة الديناميكية وفلتر قوة الاتجاه ADX ومحرك محاكاة منعزل",
  "created_at": "2026-10-11T15:45:00Z",
  "asset_universe": ["BTCUSDT", "ETHUSDT", "SOLUSDT"],
  "primary_timeframe": "15m",
  "macro_timeframes": ["1h", "4h"],
  "capital_and_risk": {
    "initial_capital_usdt": 10000.0,
    "max_capital_allocation_pct": 20.0,
    "max_open_positions": 1,
    "trading_mode": "SPOT_ONLY",
    "allow_leverage": false,
    "allow_shorting": false,
    "cash_reserve_floor_pct": 0.0,
    "maker_fee_pct": 0.10,
    "taker_fee_pct": 0.10,
    "estimated_slippage_pct": 0.05
  },
  "entry_rules": {
    "action_required": "EXECUTE_SPOT_BUY",
    "min_confluence_score": 3,
    "min_conviction_level": 2,
    "max_trap_probability": 0.20,
    "adx_filter": {
      "period": 14,
      "min_adx_threshold": 20.0,
      "require_plus_di_greater_than_minus_di": true
    },
    "dynamic_confidence_formula": {
      "base_threshold": 0.80,
      "volatility_multiplier": 0.055,
      "min_clamp": 0.78,
      "max_clamp": 0.94,
      "description": "threshold = clamp(0.80 + ((ATR_15m / Close_15m) * 100 * 0.055), 0.78, 0.94)"
    },
    "position_sizing": {
      "base_usdt_amount": 1000.0,
      "conviction_multipliers": {
        "0": 0.0,
        "1": 0.6,
        "2": 1.0,
        "3": 1.5
      },
      "max_single_trade_cap_usdt": 2000.0
    }
  },
  "exit_rules": {
    "stop_loss": {
      "type": "ATR_TRAILING_OR_FIXED",
      "atr_multiplier": 1.5,
      "reference_timeframe": "15m"
    },
    "take_profit": {
      "type": "ATR_PROJECTION",
      "atr_multiplier": 3.75,
      "risk_reward_ratio": 2.5
    },
    "emergency_early_exit": {
      "trap_probability_threshold": 0.65,
      "adx_exhaustion_threshold": 16.0,
      "di_bearish_crossover": true,
      "max_bars_in_trade": 48
    }
  },
  "validation_constraints": {
    "no_lookahead_bias": true,
    "bar_by_bar_progression": true,
    "zero_binance_orders_sent": true,
    "pure_simulation_isolation": true
  }
}
